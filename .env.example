NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_URL=http://localhost:3000
APP_NAME=GnomoTech Minecraft
MINECRAFT_SERVER_ADDRESS=play.example.com
MINECRAFT_VERSION=Java
COOKIE_SECURE=false
SESSION_DAYS=7
RESERVED_MINECRAFT_USERNAMES=admin,administrator,owner

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=minecraft_access
POSTGRES_USER=minecraft_access
POSTGRES_PASSWORD_FILE=/run/secrets/postgres-password

RCON_HOST=minecraft-server
RCON_PORT=25575
RCON_PASSWORD_FILE=/run/secrets/minecraft-rcon-password

EMAIL_DELIVERY_MODE=log
EMAIL_FROM=Minecraft Access <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD_FILE=/run/secrets/smtp-password

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_FILE=/run/secrets/turnstile-secret
